<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Single source of truth for the release version (docs/RELEASING.md). -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Microsoft.Extensions.Identity.Core (for PasswordHasher, PLAN.md §15)
         ships as part of the ASP.NET Core shared framework already - no
         explicit PackageReference needed, and one triggers NU1510. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Curato.Core\Curato.Core.csproj" />
    <ProjectReference Include="..\Curato.Data\Curato.Data.csproj" />
    <ProjectReference Include="..\Curato.iCloud\Curato.iCloud.csproj" />
    <ProjectReference Include="..\Curato.Media\Curato.Media.csproj" />
    <ProjectReference Include="..\Curato.Organizer\Curato.Organizer.csproj" />
    <ProjectReference Include="..\Curato.Vision\Curato.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied into the build output so ICloudProcessOptions's default
         AuthHelperScriptPath (AppContext.BaseDirectory-relative) resolves
         the same way for a local `dotnet run` as it does in the Docker
         image, where the Dockerfile COPYs the same folder in. -->
    <Content Include="..\tools\icloud-sync\**" LinkBase="tools\icloud-sync">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
