<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Curato.Core\Curato.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <!-- HEIC/HEIF thumbnail decode (PLAN.md §1) — plain SkiaSharp can't
         decode this format at all (no built-in HEIF codec). LibHeifSharp is
         a P/Invoke binding around the native libheif library; on its own it
         needs that native binary supplied separately (vcpkg on Windows, a
         system package on Linux), which LibHeif.Native.Runtime sidesteps by
         bundling prebuilt Windows x64 + Linux x64 binaries and copying them
         to the output directory automatically, the same "just works" bar
         SkiaSharp.NativeAssets.Linux.NoDependencies already sets above. -->
    <PackageReference Include="LibHeifSharp" Version="3.2.0" />
    <PackageReference Include="LibHeif.Native.Runtime" Version="1.20.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
